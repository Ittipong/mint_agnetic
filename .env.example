# ─────────────────────────────────────────────────────────────────────
#  Mint Agentic — example environment file
#  Copy to `.env` and fill in the credentials. All LLM-related settings
#  live in the "LLM models" section below; defaults in
#  `src/config.py` apply when a var is unset.
# ─────────────────────────────────────────────────────────────────────

# ─── Provider credentials ────────────────────────────────────────────
OPENROUTER_API_KEY=xxx
TYPOHOON_API_KEY=xxx

# ─── Databases ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mint_agentic
BACKEND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mint_money_dev

# ─── LangSmith tracing ───────────────────────────────────────────────
LANGSMITH_API_KEY=xxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=mint-agentic
LANGCHAIN_API_KEY=xxx
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=mint-agentic

# ─── LangGraph Studio ────────────────────────────────────────────────
LANGGRAPH_STUDIO_PORT=8088

# ─── FastAPI server ──────────────────────────────────────────────────
SERVER_PORT=8090

# ─── Environment + logging ───────────────────────────────────────────
# Postel's-law fallbacks are only enabled when ENVIRONMENT=production;
# dev/staging/test throw loudly so bad data is caught before shipping.
ENVIRONMENT=development
LOG_MODE=debug

# ─── Billing — Go callback ───────────────────────────────────────────
# Every OpenRouter LLM call reports its settled cost back to the Go
# backend's POST /api/v1/internal/ai-usage so the user's credit ledger
# updates. Both values are required in dev/staging/test (loud failure
# at startup); production tolerates missing values by silently
# dropping the report (loss of revenue rather than loss of service).
# Rotate the shared secret via rolling deploy — see
# docs/chat_bridge.md for the procedure.
GO_BACKEND_URL=http://localhost:3000
GO_INTERNAL_API_KEY=replace-with-32-byte-random-hex


# ═════════════════════════════════════════════════════════════════════
#  LLM models
#  Each node has its own dedicated model so we can tune speed vs cost
#  vs accuracy per task. Models routed via OpenRouter unless noted.
# ═════════════════════════════════════════════════════════════════════

# ─── 1. REACT (analytics chat — main reasoning loop) ─────────────────
REACT_MODEL=google/gemini-2.5-flash-lite
REACT_BASE_URL=https://openrouter.ai/api/v1
REACT_FALLBACK_MODELS=["deepseek/deepseek-v4-flash","google/gemini-2.5-flash"]

# Alternative: self-hosted Typhoon (no fallback support — OpenRouter only).
# REACT_MODEL=typhoon-v2.5-30b-a3b-instruct
# REACT_BASE_URL=https://api.opentyphoon.ai/v1

# ─── 2. CODEACT (sandboxed SQL/analytics execution) ──────────────────
CODEACT_MODEL=google/gemini-2.5-flash-lite
CODEACT_BASE_URL=https://openrouter.ai/api/v1
CODEACT_FALLBACK_MODELS=["deepseek/deepseek-v4-flash","google/gemini-2.5-flash"]

# ─── 3. VISION (slip / receipt parsing) ──────────────────────────────
# IMPORTANT: do NOT use `gemini-2.5-flash-lite` or `nova-lite` here —
# accuracy was tested terrible on real receipts. The regular `flash`
# tier is cheaper AND more accurate for slip OCR.
VISION_MODEL=google/gemini-2.5-flash
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_FALLBACK_MODELS=["anthropic/claude-haiku-5","openai/gpt-5-mini"]
# ─── 4. INTENT CLASSIFIER (entry-router intent detection) ────────────
# Runs every text-only turn → decides "add_transaction" vs "other".
INTENT_CLASSIFIER_MODEL=mistralai/devstral-small
INTENT_CLASSIFIER_BASE_URL=https://openrouter.ai/api/v1
INTENT_CLASSIFIER_FALLBACK_MODELS=["google/gemini-2.5-flash-lite","inception/mercury-2"]

# ─── 5. TRANSACTION (quick_add + confirmation) ───────────────────────
# Tool-calling + Thai text. nova-lite handles both well; do NOT swap
# with the vision model (different strengths).
TRANSACTION_LLM_MODEL=deepseek/deepseek-v4-flash
TRANSACTION_LLM_BASE_URL=https://openrouter.ai/api/v1
TRANSACTION_LLM_FALLBACK_MODELS=["google/gemini-2.5-flash-lite","google/gemini-2.5-flash"]

# ─── 6. STT (speech-to-text for /chat/voice) ─────────────────────────
# Multimodal model that accepts audio input.
STT_MODEL=google/gemini-2.0-flash-lite-001
STT_BASE_URL=https://openrouter.ai/api/v1
STT_FALLBACK_MODELS=["google/gemini-2.5-flash","google/gemini-2.5-flash-lite"]

