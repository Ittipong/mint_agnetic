# OpenRouter — get keys at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# PostgreSQL — uses shared backend postgres (mint_money_dev)
# DB name: mint_agentic (separate from backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mint_agentic

# Writer model (Gemma) — for LLM Writer step
MODEL=google/gemma-4-26b-a4b-it

# ReAct agent model (default Typhoon, can swap to OpenRouter)
REACT_MODEL=typhoon-v2.5-30b-a3b-instruct
REACT_BASE_URL=https://api.opentyphoon.ai/v1
# Fallback models — only active when REACT_BASE_URL is OpenRouter
# REACT_FALLBACK_MODELS=["google/gemini-2.5-flash-lite","openai/gpt-4o-mini"]

# CodeAct agent model (separate from ReAct — runs the sandbox code loop)
CODEACT_MODEL=openai/gpt-oss-safeguard-20b:nitro
CODEACT_BASE_URL=https://openrouter.ai/api/v1
# Fallback models — tried in order when primary is down/rate-limited
# CODEACT_FALLBACK_MODELS=["google/gemini-2.5-flash-lite","openai/gpt-4o-mini"]

# Vision model — slip OCR subgraph (must support image_url content blocks)
VISION_MODEL=bytedance-seed/seedream-4.5
VISION_BASE_URL=https://openrouter.ai/api/v1


# LangGraph Studio (optional)
LANGGRAPH_STUDIO_PORT=8080
