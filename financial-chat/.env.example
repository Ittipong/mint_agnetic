# OpenRouter — get keys at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# PostgreSQL — uses shared backend postgres (mint_money_dev)
# DB name: mint_agentic (separate from backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mint_agentic

# Writer model (Gemma) — for LLM Writer step
MODEL=google/gemma-4-26b-a4b-it

# Intent router model (ministral) — for classification step
INTENT_MODEL=mistralai/ministral-3b-2512

# LangGraph Studio (optional)
LANGGRAPH_STUDIO_PORT=8080
