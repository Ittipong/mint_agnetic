# ═════════════════════════════════════════════════════════════════════
#  Mint Agentic v3 — copy to `.env` and fill in credentials.
#  All <ROLE>_MODEL entries REQUIRE a matching <ROLE>_FALLBACK_MODELS
#  with ≥ 2 OpenRouter slugs — validated at server startup.
# ═════════════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════════════
#  1. Credentials & routing
# ═════════════════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-REPLACE-ME

# OpenRouter provider routing — `latency` prefers fastest upstream.
#   sort  = latency | throughput | price
#   order = pin providers, e.g. "deepinfra,google-vertex"
OPENROUTER_PROVIDER_SORT=latency
# OPENROUTER_PROVIDER_ORDER=


# ═════════════════════════════════════════════════════════════════════
#  2. Runtime — version, env, ports
# ═════════════════════════════════════════════════════════════════════
CHAT_AGENT_VERSION=v3
ENVIRONMENT=development
LOG_MODE=debug
SESSION_LOG_DIR=logs

LANGGRAPH_STUDIO_PORT=8088
SERVER_PORT=8090


# ═════════════════════════════════════════════════════════════════════
#  3. Databases
#    v3 schema isolation via `?options=-c%20search_path%3Dv3`
# ═════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mint_agentic?options=-c%20search_path%3Dv3
BACKEND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mint_money_dev


# ═════════════════════════════════════════════════════════════════════
#  4. Observability — LangSmith tracing
# ═════════════════════════════════════════════════════════════════════
LANGSMITH_API_KEY=lsv2_pt_REPLACE_ME
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=mint-agentic_v3
LANGCHAIN_API_KEY=lsv2_pt_REPLACE_ME
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=mint-agentic_v3


# ═════════════════════════════════════════════════════════════════════
#  5. Billing — Go backend ai-usage callback
#    Required in dev/staging/test; prod tolerates missing (silent drop).
# ═════════════════════════════════════════════════════════════════════
GO_BACKEND_URL=http://localhost:3000
GO_INTERNAL_API_KEY=replace-with-32-byte-random-hex


# ═════════════════════════════════════════════════════════════════════
#  6. LLM MODELS — user-facing (per-request critical path)
#    Pattern: <ROLE>_MODEL + <ROLE>_FALLBACK_MODELS (≥2) + <ROLE>_BASE_URL
# ═════════════════════════════════════════════════════════════════════

# 6.1 PREAMBLE — 1-sentence Thai warm-up streamed in <500ms BEFORE ReAct.
#     Set PREAMBLE_ENABLED=0 to skip (saves 1 LLM call / turn).
PREAMBLE_ENABLED=1
PREAMBLE_TIMEOUT_S=8
PREAMBLE_MODEL=google/gemini-2.5-flash-lite
PREAMBLE_FALLBACK_MODELS=["google/gemini-2.0-flash-lite-001","deepseek/deepseek-v4-flash"]

# 6.2 REACT — main reasoning loop (tool selection + final answer).
REACT_MODEL=google/gemini-3.1-flash-lite
REACT_BASE_URL=https://openrouter.ai/api/v1
REACT_FALLBACK_MODELS=["qwen/qwen3.6-flash","google/gemini-2.5-flash-lite"]

# 6.3 CODEACT — resolver rerank (entity disambiguation, structured output).
CODEACT_MODEL=google/gemini-2.5-flash-lite
CODEACT_BASE_URL=https://openrouter.ai/api/v1
CODEACT_FALLBACK_MODELS=["deepseek/deepseek-v4-flash","google/gemini-2.5-flash"]

# 6.4 VISION — slip / receipt OCR.
#     Do NOT use *-flash-lite or nova-lite — accuracy tested terrible.
VISION_MODEL=google/gemini-2.5-flash
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_FALLBACK_MODELS=["anthropic/claude-haiku-5","openai/gpt-5-mini"]

# 6.5 STT — speech-to-text for /chat/voice (multimodal audio).
#     *-flash-lite hallucinates Thai fillers ("ครับผม") on noisy audio.
STT_MODEL=google/gemini-2.5-flash-lite
STT_BASE_URL=https://openrouter.ai/api/v1
STT_FALLBACK_MODELS=["google/gemini-2.5-flash","google/gemini-2.0-flash-lite-001"]

# 6.6 PROPOSE — joint wallet+category resolver inside propose_transaction.
#     Replaces the legacy 2-call chain (resolve_wallet_choice_async +
#     resolve_category_for_add_async) with ONE structured-output call.
#     Hot path on every ADD turn — keep it cheap + fast.
PROPOSE_MODEL=google/gemini-2.5-flash-lite
PROPOSE_BASE_URL=https://openrouter.ai/api/v1
PROPOSE_FALLBACK_MODELS=["google/gemini-3.1-flash-lite","google/gemini-2.5-flash"]

# 6.x CLASSIFY — in-graph stateful intent classifier (classify_intent node).
#     Used only when CLASSIFY_ROUTER_ENABLED=1 (default OFF; see section below);
#     env is ALWAYS set so validate_llm_env passes at startup (≥2 fallbacks).
CLASSIFY_MODEL=google/gemini-2.5-flash-lite
CLASSIFY_FALLBACK_MODELS=["google/gemini-3.1-flash-lite","google/gemini-2.5-flash"]


# ─────────────────────────────────────────────────────────────────────
#  Classify-router (Wave 8) — in-graph STATEFUL intent classifier.
#
#  The classify_intent graph node (src/agent/nodes/classify_intent.py) can
#  shortcut an unambiguous, complete ADD to a deterministic direct_add node
#  (skipping the ReAct loop). It SEES windowed conversation history, so it
#  routes a bare amount that ANSWERS an advisor question (the E9 case) back to
#  react instead of mis-firing an ADD. This is the single intent classifier
#  in v3.
#
#  Model env (CLASSIFY_MODEL / CLASSIFY_FALLBACK_MODELS) lives in section 6 and
#  is ALWAYS set + validated at startup. The toggle below only flips the node
#  behavior: OFF → every turn → react, classify_intent makes NO LLM call.
#
#    CLASSIFY_ROUTER_ENABLED   1 | 0 (default 0 → OFF → every turn → react)
#    CLASSIFY_TIMEOUT_S        float seconds (default 4.0; passed to make_llm_call)
#
#  Keep OFF in real .env until eval (LangSmith mint_v3_eval_v1) confirms the
#  router's ADD-shortcut precision + E9 recall meet bars.
CLASSIFY_ROUTER_ENABLED=0
CLASSIFY_TIMEOUT_S=4.0


# ═════════════════════════════════════════════════════════════════════
#  8. LLM MODELS — testing only
# ═════════════════════════════════════════════════════════════════════

# 8.1 JUDGE — LLM-as-judge for integration tests (tests_integration/).
JUDGE_MODEL=deepseek/deepseek-v4-flash
JUDGE_FALLBACK_MODELS=["google/gemini-2.5-flash","google/gemini-2.5-flash-lite"]
