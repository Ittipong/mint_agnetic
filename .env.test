# OpenRouter — get keys at https://openrouter.ai/keys
OPENROUTER_API_KEY=xxxx

# PostgreSQL — separate test database
DATABASE_URL=postgresql://mint:mint123@localhost:5433/mint_agentic

# Writer model (Gemma) — for LLM Writer step
MODELS=["google/gemini-2.5-flash-lite", "google/gemma-4-26b-a4b-it"]

# MODEL1=google/gemini-2.5-flash-lite
# MODEL2=google/gemma-4-26b-a4b-it

# LangSmith — required for evaluation
LANGSMITH_API_KEY=ssss
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=mint-agentic
EVALUATORS_PROJECT=evaluators_compare
EVAL_DATASET_NAME=compare-llm

# LangGraph Studio (optional)
LANGGRAPH_STUDIO_PORT=8080
